  "query": "\n            SELECT n.id, n.slug, n.created_by, n.created_at\n            FROM namespaces n\n            INNER JOIN namespace_members nm ON n.id = nm.namespace_id\n            WHERE nm.user_id = $1\n            ORDER BY n.created_at DESC\n            ",
